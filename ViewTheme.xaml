<ResourceDictionary xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation'
                    xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml'>
    <SolidColorBrush x:Key='Ink' Color='#243247'/>
    <SolidColorBrush x:Key='Secondary' Color='#526176'/>
    <SolidColorBrush x:Key='Paper' Color='#F8FAFD'/>
    <SolidColorBrush x:Key='Edge' Color='#DCE5EF'/>
    <SolidColorBrush x:Key='Tint' Color='#E5EDF7'/>
    <SolidColorBrush x:Key='Hover' Color='#EAF0F7'/>
    <SolidColorBrush x:Key='Accent' Color='#42658F'/>
    <SolidColorBrush x:Key='SliderActive' Color='#7895B4'/>

    <Style x:Key='SoftButton' TargetType='Button'>
        <Setter Property='Background' Value='Transparent'/>
        <Setter Property='BorderBrush' Value='Transparent'/>
        <Setter Property='BorderThickness' Value='1'/>
        <Setter Property='Foreground' Value='{StaticResource Ink}'/>
        <Setter Property='Cursor' Value='Hand'/>
        <Setter Property='Template'>
            <Setter.Value>
                <ControlTemplate TargetType='Button'>
                    <Border x:Name='Surface' CornerRadius='9' Background='{TemplateBinding Background}'
                            BorderBrush='{TemplateBinding BorderBrush}' BorderThickness='{TemplateBinding BorderThickness}'>
                        <ContentPresenter HorizontalAlignment='Center' VerticalAlignment='Center'/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property='IsMouseOver' Value='True'>
                            <Setter TargetName='Surface' Property='Background' Value='{StaticResource Hover}'/>
                        </Trigger>
                        <Trigger Property='IsPressed' Value='True'>
                            <Setter TargetName='Surface' Property='Background' Value='{StaticResource Tint}'/>
                        </Trigger>
                        <Trigger Property='IsKeyboardFocused' Value='True'>
                            <Setter TargetName='Surface' Property='BorderBrush' Value='{StaticResource Accent}'/>
                        </Trigger>
                        <Trigger Property='IsEnabled' Value='False'>
                            <Setter TargetName='Surface' Property='Opacity' Value='0.55'/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key='PrimaryButton' TargetType='Button' BasedOn='{StaticResource SoftButton}'>
        <Setter Property='Background' Value='{StaticResource Tint}'/>
        <Setter Property='BorderBrush' Value='{StaticResource Edge}'/>
        <Setter Property='Foreground' Value='{StaticResource Accent}'/>
        <Setter Property='FontWeight' Value='SemiBold'/>
    </Style>

    <Style x:Key='SectionTab' TargetType='TabItem'>
        <Setter Property='Padding' Value='12,5'/>
        <Setter Property='Foreground' Value='{StaticResource Secondary}'/>
        <Setter Property='Template'>
            <Setter.Value>
                <ControlTemplate TargetType='TabItem'>
                    <Border x:Name='Section' Background='Transparent' BorderBrush='Transparent' BorderThickness='1'
                            CornerRadius='8' Padding='{TemplateBinding Padding}' Margin='1,0'>
                        <ContentPresenter x:Name='SectionLabel' ContentSource='Header' HorizontalAlignment='Center' VerticalAlignment='Center'/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property='IsMouseOver' Value='True'>
                            <Setter TargetName='Section' Property='Background' Value='{StaticResource Hover}'/>
                        </Trigger>
                        <Trigger Property='IsSelected' Value='True'>
                            <Setter TargetName='Section' Property='Background' Value='White'/>
                            <Setter TargetName='Section' Property='BorderBrush' Value='{StaticResource Edge}'/>
                            <Setter TargetName='SectionLabel' Property='TextElement.Foreground' Value='{StaticResource Accent}'/>
                            <Setter TargetName='SectionLabel' Property='TextElement.FontWeight' Value='SemiBold'/>
                        </Trigger>
                        <Trigger Property='IsKeyboardFocused' Value='True'>
                            <Setter TargetName='Section' Property='BorderBrush' Value='{StaticResource Accent}'/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key='SectionTabs' TargetType='TabControl'>
        <Setter Property='ItemContainerStyle' Value='{StaticResource SectionTab}'/>
        <Setter Property='Template'>
            <Setter.Value>
                <ControlTemplate TargetType='TabControl'>
                    <DockPanel KeyboardNavigation.TabNavigation='Local'>
                        <Border DockPanel.Dock='Top' HorizontalAlignment='Left' Background='{StaticResource Hover}'
                                BorderBrush='{StaticResource Edge}' BorderThickness='1' CornerRadius='11' Padding='3'>
                            <TabPanel IsItemsHost='True' KeyboardNavigation.TabNavigation='Once'/>
                        </Border>
                        <ContentPresenter x:Name='PART_SelectedContentHost' ContentSource='SelectedContent' Margin='0,13,0,0'/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType='TextBox'>
        <Setter Property='Foreground' Value='{StaticResource Ink}'/>
        <Setter Property='Background' Value='White'/>
        <Setter Property='BorderBrush' Value='{StaticResource Edge}'/>
        <Setter Property='BorderThickness' Value='1'/>
        <Setter Property='Template'>
            <Setter.Value>
                <ControlTemplate TargetType='TextBox'>
                    <Border x:Name='Field' CornerRadius='8' BorderThickness='{TemplateBinding BorderThickness}'
                            BorderBrush='{TemplateBinding BorderBrush}' Background='{TemplateBinding Background}'>
                        <ScrollViewer x:Name='PART_ContentHost' Focusable='False' Margin='{TemplateBinding Padding}'/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property='IsKeyboardFocusWithin' Value='True'>
                            <Setter TargetName='Field' Property='BorderBrush' Value='{StaticResource Accent}'/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType='CheckBox'>
        <Setter Property='Foreground' Value='{StaticResource Ink}'/>
        <Setter Property='Template'>
            <Setter.Value>
                <ControlTemplate TargetType='CheckBox'>
                    <DockPanel Background='Transparent' MinHeight='23'>
                        <Border x:Name='Box' Width='16' Height='16' CornerRadius='4' Margin='0,0,8,0'
                                VerticalAlignment='Center' Background='White' BorderBrush='{StaticResource Edge}' BorderThickness='1'>
                            <Path x:Name='Tick' Data='M 0,3 L 3,6 L 8,0' Stroke='{StaticResource Accent}' StrokeThickness='1.6'
                                  StrokeStartLineCap='Round' StrokeEndLineCap='Round' StrokeLineJoin='Round'
                                  HorizontalAlignment='Center' VerticalAlignment='Center' Visibility='Hidden'/>
                        </Border>
                        <ContentPresenter VerticalAlignment='Center' RecognizesAccessKey='True'/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property='IsChecked' Value='True'>
                            <Setter TargetName='Box' Property='Background' Value='{StaticResource Tint}'/>
                            <Setter TargetName='Tick' Property='Visibility' Value='Visible'/>
                        </Trigger>
                        <Trigger Property='IsKeyboardFocused' Value='True'>
                            <Setter TargetName='Box' Property='BorderBrush' Value='{StaticResource Accent}'/>
                        </Trigger>
                        <Trigger Property='IsEnabled' Value='False'>
                            <Setter Property='Opacity' Value='0.55'/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key='SliderFill' TargetType='RepeatButton'>
        <Grid Background='Transparent'><Border Height='4' CornerRadius='2' Background='{StaticResource SliderActive}'/></Grid>
    </ControlTemplate>
    <ControlTemplate x:Key='SliderRemainder' TargetType='RepeatButton'>
        <Grid Background='Transparent'><Border Height='4' CornerRadius='2' Background='{StaticResource Edge}'/></Grid>
    </ControlTemplate>
    <Style TargetType='Slider'>
        <Setter Property='Template'>
            <Setter.Value>
                <ControlTemplate TargetType='Slider'>
                    <Grid x:Name='Rail' Background='Transparent'>
                        <Track x:Name='PART_Track'>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Template='{StaticResource SliderFill}' Command='Slider.DecreaseLarge' Focusable='False'/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Template='{StaticResource SliderRemainder}' Command='Slider.IncreaseLarge' Focusable='False'/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width='15' Height='15'>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType='Thumb'>
                                            <Ellipse Fill='White' Stroke='{StaticResource Accent}' StrokeThickness='1.5'/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <Border x:Name='RailFocus' IsHitTestVisible='False' Visibility='Hidden' CornerRadius='6'
                                BorderBrush='{StaticResource Accent}' BorderThickness='1'/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property='IsKeyboardFocused' Value='True'>
                            <Setter TargetName='RailFocus' Property='Visibility' Value='Visible'/>
                        </Trigger>
                        <Trigger Property='IsEnabled' Value='False'>
                            <Setter TargetName='Rail' Property='Opacity' Value='0.42'/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType='ToolTip'>
        <Setter Property='Foreground' Value='{StaticResource Ink}'/>
        <Setter Property='Template'>
            <Setter.Value>
                <ControlTemplate TargetType='ToolTip'>
                    <Border Background='{StaticResource Paper}' BorderBrush='{StaticResource Edge}' BorderThickness='1'
                            CornerRadius='7' Padding='8,5'>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key='SoftContextMenu' TargetType='ContextMenu'>
        <Setter Property='HasDropShadow' Value='False'/>
        <Setter Property='Foreground' Value='{StaticResource Ink}'/>
        <Setter Property='Template'>
            <Setter.Value>
                <ControlTemplate TargetType='ContextMenu'>
                    <Border Background='{StaticResource Paper}' BorderBrush='{StaticResource Edge}' BorderThickness='1' CornerRadius='11' Padding='5'>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation='Cycle'/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key='SoftMenuItem' TargetType='MenuItem'>
        <Setter Property='Padding' Value='10,6'/>
        <Setter Property='Foreground' Value='{StaticResource Ink}'/>
        <Setter Property='Template'>
            <Setter.Value>
                <ControlTemplate TargetType='MenuItem'>
                    <Border x:Name='Row' Background='Transparent' CornerRadius='6' Padding='{TemplateBinding Padding}'>
                        <ContentPresenter ContentSource='Header' RecognizesAccessKey='True'/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property='IsHighlighted' Value='True'>
                            <Setter TargetName='Row' Property='Background' Value='{StaticResource Hover}'/>
                        </Trigger>
                        <Trigger Property='IsEnabled' Value='False'>
                            <Setter TargetName='Row' Property='Opacity' Value='0.45'/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key='SoftSeparator' TargetType='Separator'>
        <Setter Property='Template'>
            <Setter.Value>
                <ControlTemplate TargetType='Separator'>
                    <Border Height='1' Margin='7,4' Background='{StaticResource Edge}'/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
